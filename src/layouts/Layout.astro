---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { business } from '../data/business';
import '@fontsource-variable/manrope';
import '@fontsource/marcellus/latin-400.css';
import '@fontsource/cormorant-garamond/latin-500-italic.css';
import '../styles/global.css';
interface Props { title: string; description: string; service?: string; noindex?: boolean; }
const { title, description, service, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, business.site).href;
const indexable = import.meta.env.PUBLIC_INDEXABLE !== 'false' && !noindex;
const organisation = { '@type': 'Organization', '@id': `${business.site}/#organisation`, name: business.name, alternateName: business.shortName, url: business.site, logo: `${business.site}/images/logo.webp`, telephone: '+919711161009', email: business.email, areaServed: 'Delhi NCR', description: 'Professional driver, chauffeur, valet parking, PSO, bouncer and security personnel services.' };
const schema = { '@context': 'https://schema.org', '@graph': [organisation, ...(service ? [{ '@type': 'Service', name: service, serviceType: service, areaServed: 'Delhi NCR', provider: { '@id': `${business.site}/#organisation` }, url: canonical }] : []), ...(Astro.url.pathname !== '/' && !noindex ? [{ '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: `${business.site}/` }, { '@type': 'ListItem', position: 2, name: title.split(' | ')[0], item: canonical }] }] : [])] };
---
<!doctype html><html lang="en-IN"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><meta name="theme-color" content="#021a14" /><title>{title} | JSS Elite Group India</title><meta name="description" content={description} /><meta name="robots" content={indexable ? 'index, follow' : 'noindex, nofollow'} /><link rel="canonical" href={canonical} /><link rel="icon" type="image/svg+xml" href="/favicon.svg" /><meta property="og:type" content="website" /><meta property="og:locale" content="en_IN" /><meta property="og:site_name" content={business.shortName} /><meta property="og:title" content={`${title} | JSS Elite Group India`} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} /><meta property="og:image" content={`${business.site}/images/social.jpg`} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta name="twitter:card" content="summary_large_image" /><script type="application/ld+json" set:html={JSON.stringify(schema)} /></head><body><Header /><main id="main"><slot /></main><Footer /><script>
import '../scripts/site';
</script></body></html>
