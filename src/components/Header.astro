---
import Icon from './Icon.astro';
import { business, socialLinks, whatsapp } from '../data/business';
import { services, servicePath, servicesInGroup, groupLabels, type ServiceGroupKey } from '../data/services';
const path = Astro.url.pathname;
const nav = [
  { title: 'Home', url: '/' },
  { title: 'About Us', url: '/about-us/' },
  { title: 'Our Services', url: '/our-services/', mega: true },
  { title: 'Driver Services', url: '/driver-services/', hideLg: true },
  { title: 'PSO & Security', url: '/pso-security-services/' },
  { title: 'Valet Parking', url: '/valet-parking/', hideLg: true },
  { title: 'Contact Us', url: '/contact-us/' },
];
const groups: ServiceGroupKey[] = ['driver', 'security', 'hospitality'];
---
<a class="skip-link" href="#main">Skip to content</a>
<div class="topbar"><div class="wrap topbar-inner">
  <span class="topbar-tag">Professional<b>•</b>Reliable<b>•</b>Trusted</span>
  <div class="topbar-links">
    <a href={`mailto:${business.email}`}><Icon name="mail" size={14} />{business.email}</a>
    <a href={business.alternateLink}><Icon name="phone" size={14} />99111 56199</a>
    <span><Icon name="pin" size={14} />{business.area}</span>
    {socialLinks.map(s => <a href={s.url} aria-label={s.name} target="_blank" rel="noopener noreferrer"><Icon name={s.icon} size={15} /></a>)}
  </div>
</div></div>
<header class="site-header"><div class="wrap header-inner">
  <a href="/" class="brand" aria-label="JSS Elite Group India home"><img src="/images/logo-clean.webp" srcset="/images/logo-clean.webp 520w, /images/logo-clean@2x.webp 1040w" sizes="160px" alt="JSS Elite Group India — Driver & Security Services" width="520" height="233" /></a>
  <nav class="primary-nav" aria-label="Main navigation"><ul>
    {nav.map(link => (
      <li class:list={['nav-item', { 'nav-hide-lg': link.hideLg }]}>
        <a class="nav-link" href={link.url} aria-current={path === link.url ? 'page' : undefined}>{link.title}</a>
        {link.mega && <button class="mega-toggle" type="button" aria-label="Show all services" aria-expanded="false" aria-controls="services-mega"><Icon name="down" size={14} /></button>}
      </li>
    ))}
  </ul></nav>
  <div class="header-actions">
    <a href={business.phoneLink} class="header-call" aria-label="Call 97111 61009"><span class="ring"><Icon name="phone" size={18} /></span><span><small>Call now</small>97111 61009</span></a>
    <button class="menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="mobile-menu"><Icon name="menu" size={22} /></button>
  </div>
  <div class="mega" id="services-mega" hidden>
    {groups.map(group => (
      <div class="mega-group"><h3>{groupLabels[group]}</h3>
        {servicesInGroup(group).map(s => <a href={servicePath(s)}><Icon name={s.icon} size={20} /><strong>{s.short}</strong><span>{s.description}</span></a>)}
      </div>
    ))}
    <div class="mega-promo on-dark pattern-lines">
      <div><span class="eyebrow">Not sure which fits?</span><h3 class="light-heading">Tell us your requirement. <em class="accent">We’ll talk it through.</em></h3></div>
      <p>Share the service, location, date and duration with our team.</p>
      <div class="actions"><a href="/our-services/" class="btn btn-sm">All services <Icon name="arrow" size={16} class="icon-end" /></a><a href={whatsapp()} class="btn btn-sm btn-ghost" target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" size={16} />WhatsApp</a></div>
    </div>
  </div>
</div></header>
<noscript><details class="nojs-menu wrap"><summary>Browse pages & services</summary><nav aria-label="Navigation without JavaScript">{nav.map(link => <a href={link.url}>{link.title}</a>)}{services.map(s => <a href={servicePath(s)}>{s.short}</a>)}</nav></details><style>.menu-toggle,.mega-toggle{display:none!important}.nojs-menu{padding-block:14px}.nojs-menu summary{font-weight:700}.nojs-menu nav{display:flex;flex-wrap:wrap;gap:15px;padding-block:18px}</style></noscript>
<dialog class="mobile-menu" id="mobile-menu" aria-label="Mobile navigation">
  <div class="mobile-menu-top"><img src="/images/logo-clean.webp" alt="JSS Elite Group India" width="520" height="233" /><button class="menu-close" type="button" aria-label="Close navigation"><Icon name="close" size={22} /></button></div>
  <nav class="mobile-nav" aria-label="Mobile main navigation">{nav.map((link, i) => <a href={link.url} aria-current={path === link.url ? 'page' : undefined}><span>0{i + 1}</span>{link.title}<Icon name="arrow" size={20} /></a>)}</nav>
  <details class="mobile-services"><summary>All {services.length} services <Icon name="down" size={18} /></summary><div class="mobile-service-links">{services.map(s => <a href={servicePath(s)}><Icon name={s.icon} size={16} />{s.short}</a>)}</div></details>
  <div class="mobile-menu-contact">
    <a href={business.phoneLink} class="btn"><Icon name="phone" size={18} />Call 97111 61009</a>
    <a href={whatsapp()} class="btn btn-whatsapp" target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" size={18} />WhatsApp our team</a>
    <a href={`mailto:${business.email}`} class="btn btn-ghost"><Icon name="mail" size={18} />{business.email}</a>
  </div>
</dialog>
<div class="scroll-progress" aria-hidden="true"></div>
