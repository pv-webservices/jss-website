---
// Serves an AI-generated asset when it has been generated (see scripts/generate-images.mjs),
// otherwise the curated stock fallback. Pages never reference a missing file.
import generated from '../data/generated-images.json';

interface GeneratedImage { src: string; widths: number[]; width: number; height: number; }
interface Props { name: string; alt: string; class?: string; hero?: boolean; position?: string; sizes?: string; }

const STOCK_FALLBACK: Record<string, string> = { team: 'about', portrait: 'chauffeur' };
const STOCK_WIDTHS = [480, 960, 1600];

const { name, alt, class: className = '', hero = false, position, sizes = '(max-width: 640px) 100vw, (max-width: 1000px) 50vw, 40vw' } = Astro.props;
const gen = (generated as Record<string, GeneratedImage>)[name];
const stock = STOCK_FALLBACK[name] ?? name;
const base = gen ? `/images/${gen.src}` : `/images/${stock}`;
const widths = gen ? gen.widths : STOCK_WIDTHS;
const mid = widths[Math.min(1, widths.length - 1)];
const width = gen?.width ?? 1600;
const height = gen?.height ?? 1067;
---
<img src={`${base}-${mid}.webp`} srcset={widths.map(w => `${base}-${w}.webp ${w}w`).join(', ')} sizes={sizes} width={width} height={height} alt={alt} class={className} style={position ? `object-position:${position}` : undefined} loading={hero ? 'eager' : 'lazy'} decoding={hero ? 'sync' : 'async'} fetchpriority={hero ? 'high' : 'auto'} />
