# Production uses the supplied www domain. Set false for staging deployments.
PUBLIC_INDEXABLE=true
# Add only the company's confirmed profile URLs. Missing links are hidden.
PUBLIC_INSTAGRAM_URL=
PUBLIC_FACEBOOK_URL=
PUBLIC_GOOGLE_BUSINESS_URL=

# --- AI image generation (build tooling only; never exposed to the browser) ---
# Used by `npm run images:generate`. Keep it in .env (git-ignored) — never commit it.
OPENAI_API_KEY=
# Optional overrides — defaults live in scripts/images/config.mjs
# OPENAI_IMAGE_MODEL_FLARE=gpt-image-2.5-flare
# OPENAI_IMAGE_MODEL_SUNBURST=gpt-image-2.5-sunburst
# OPENAI_IMAGE_QUALITY_DEFAULT=medium
# OPENAI_IMAGE_QUALITY_PREMIUM=high
